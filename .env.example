# =========================================================================
# HManga Library — Cấu hình Biến Môi Trường (.env)
# =========================================================================
# Hướng dẫn: Sao chép file này thành '.env' và điền thông tin Supabase của bạn.

# 1. Supabase Database Credentials (Bắt buộc)
# Lấy tại: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Cấu hình Backend (Tùy chọn)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
COVER_IMAGES_DIR=frontend/assets
CACHE_FILE=backend/data_cache/comics_cache.json